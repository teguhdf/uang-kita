# App
NODE_ENV=development
PORT=5555
APP_URL=http://localhost:5555
APP_TIMEZONE=Asia/Jakarta
HAS_CERTIFICATE=false
# Only used when HAS_CERTIFICATE=true. Production behind Nginx should leave it false.
TLS_KEY_PATH=
TLS_CERT_PATH=
LOG_LEVEL=info

# Database
DB_CONNECTION=development
# Production example: /var/lib/uang-kita/production.sqlite3
DB_PATH=
DEV_DB_PATH=./data/dev.sqlite3
TEST_DB_PATH=./data/test.sqlite3

# Local file storage
# Production example: /var/lib/uang-kita/storage
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_PUBLIC_URL=/storage

# Backup
# Production example: /var/backups/uang-kita
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Google OAuth (disabled until explicitly configured)
ENABLE_GOOGLE_OAUTH=false
GOOGLE_REDIRECT_URI=http://localhost:5555/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password recovery / transactional email
RESEND_API_KEY=
MAIL_FROM_NAME=Sedalam Ini.
MAIL_FROM_ADDRESS=
DRIPSENDER_API_KEY=

# Object storage integrations (optional)
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_BUCKET=
WASABI_REGION=ap-southeast-1
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
BACKUP_ENCRYPTION_KEY=
CDN_URL=
