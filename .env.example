# App
NODE_ENV=development
PORT=5555
APP_URL=http://localhost:5555
HAS_CERTIFICATE=false
LOG_LEVEL=info

# Database
DB_CONNECTION=development
# Production example: /var/lib/uang-kita/production.sqlite3
DB_PATH=
DEV_DB_PATH=./data/dev.sqlite3
TEST_DB_PATH=./data/test.sqlite3

# Local file storage
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_PUBLIC_URL=/storage

# Backup
# Production example: /var/backups/uang-kita
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Google OAuth (optional)
GOOGLE_REDIRECT_URI=http://localhost:5555/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage / backup integrations (optional)
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_BUCKET=laju-dev
WASABI_REGION=ap-southeast-1
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
BACKUP_ENCRYPTION_KEY=
CDN_URL=

# Email (optional until email delivery is enabled)
RESEND_API_KEY=
DRIPSENDER_API_KEY=
USER_MAILER=
PASS_MAILER=
